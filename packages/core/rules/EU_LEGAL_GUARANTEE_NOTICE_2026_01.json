{
  "requirement": "EU_LEGAL_GUARANTEE_NOTICE",
  "rule_id": "EU_LEGAL_GUARANTEE_NOTICE_2026_01",
  "version": 2,
  "level": "STORE",
  "effective_from": "2026-09-27",
  "sources": [
    "Directive (EU) 2024/825",
    "Implementing Regulation (EU) 2025/1960",
    "European Commission guidance, April 2026"
  ],
  "asset_policy": {
    "format": "SVG_RGB",
    "modifiable": false,
    "source_version": "2025/1960-2026-04-guidance"
  },
  "accepted_entry_points": [
    "header",
    "catalog",
    "checkout",
    "top-bar"
  ],
  "surfaces": [
    "storefront",
    "checkout",
    "confirmation_email"
  ],
  "evaluation": {
    "derive": {
      "notice": {
        "fn": "resolveNoticeAsset"
      }
    },
    "gates": [
      {
        "check": {
          "not": {
            "eq": [
              "$derived.notice.outcome",
              "NOT_IN_SCOPE_V1"
            ]
          }
        },
        "on_false": "NOT_APPLICABLE",
        "reason": "market_not_eu27"
      },
      {
        "check": {
          "not": {
            "eq": [
              "$derived.notice.outcome",
              "LANGUAGE_REVIEW_REQUIRED"
            ]
          }
        },
        "on_false": "UNKNOWN",
        "reason": "language_review_required"
      }
    ],
    "required": [
      "$evidence"
    ],
    "checks": [
      {
        "check": {
          "has": [
            "$evidence.officialHashes",
            "$evidence.assetHash"
          ]
        },
        "reason": "asset_not_official"
      },
      {
        "check": {
          "eq": [
            "$evidence.assetLocale",
            "$derived.notice.locale"
          ]
        },
        "reason": "asset_locale_mismatch"
      },
      {
        "check": {
          "eq": [
            "$evidence.isRgb",
            true
          ]
        },
        "reason": "asset_not_rgb"
      },
      {
        "check": {
          "in": [
            "$evidence.entryPoint",
            [
              "header",
              "catalog",
              "checkout",
              "top-bar"
            ]
          ]
        },
        "reason": "entry_point_not_supported_by_product_policy"
      },
      {
        "check": {
          "not": {
            "gt": [
              "$evidence.interactionsToFullNotice",
              1
            ]
          }
        },
        "reason": "full_notice_not_reachable_in_one_interaction"
      },
      {
        "check": {
          "eq": [
            "$evidence.yourEuropeLinkPresent",
            true
          ]
        },
        "reason": "your_europe_link_missing"
      }
    ],
    "verification": {
      "checks": [
        "$verification.noticePresentation"
      ],
      "surfaces": [
        "storefront",
        "checkout",
        "confirmation_email"
      ],
      "surfaces_verified": "$evidence.surfacesVerified"
    }
  },
  "market_activation": {
    "regime": "EMPCO_2024_825",
    "required": true,
    "max_status_when_not_verified_active": "CONFIGURED"
  },
  "interpretation_revision": {
    "id": "NOTICE-PLACEMENT-2026-09-13",
    "date": "2026-09-13",
    "source": "https://commission.europa.eu/document/download/3e4dbee6-8184-4256-923d-c52551c7e9f0_en",
    "section": "2.3, printed pages 15-19",
    "basis": "Locations are non-exhaustive examples. Supported placements below are product policy, not an exhaustive legal whitelist.",
    "supersedes_version": 1
  },
  "presentation_policy": {
    "version": 1,
    "positions": {
      "top-bar": {
        "decision": "supported_with_review",
        "entry_point": "top-bar"
      },
      "bottom-right": {
        "decision": "review_required",
        "entry_point": null
      },
      "bottom-left": {
        "decision": "review_required",
        "entry_point": null
      },
      "inline": {
        "decision": "review_required",
        "entry_point": null
      }
    }
  }
}
