{
  "name": "eu-store-guard",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/worker"
  ],
  "scripts": {
    "lint": "eslint . && node scripts/secret-scan.mjs",
    "test": "npm test --workspaces",
    "build": "npm run build --workspace apps/worker",
    "audit:ci": "npm audit --audit-level=high",
    "bundle:check": "node scripts/bundle-check.mjs",
    "bundle:build": "node scripts/bundle-rules.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.12.0",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=20"
  }
}
